{
  "name": "educsyn-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Socle frontend hybride offline-first pour EducSyn.",
  "scripts": {
    "dev": "vite",
    "dev:actors": "vite --mode development",
    "dev:login": "vite --mode login",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "certify:security-browser": "node scripts/certify-security-center-browser.cjs",
    "certify:platform-governance-navigation": "node scripts/certify-platform-governance-navigation.cjs",
    "test": "vue-tsc --noEmit && node -e \"require('./scripts/run-configuration-form-tests.cjs'); require('./scripts/run-school-administration-tests.cjs')\""
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "lucide-vue-next": "^1.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
