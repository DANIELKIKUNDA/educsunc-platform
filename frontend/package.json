{
  "name": "educsyn-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Socle frontend hybride offline-first pour EducSyn.",
  "scripts": {
    "dev": "vite",
    "dev:actors": "vite --mode development",
    "dev:login": "vite --mode login",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "certify:security-browser": "node scripts/certify-security-center-browser.cjs",
    "certify:platform-governance-navigation": "node scripts/certify-platform-governance-navigation.cjs",
    "test:e2e:g1": "playwright test --config e2e/g1/playwright.g1.config.ts",
    "test:e2e:g1:list": "playwright test --config e2e/g1/playwright.g1.config.ts --list",
    "test:access": "node --test scripts/run-effective-access-tests.cjs scripts/run-frontend-lifecycle-tests.cjs",
    "test": "vue-tsc --noEmit && node -e \"require('./scripts/run-configuration-form-tests.cjs'); require('./scripts/run-school-administration-tests.cjs')\" && npm run test:access"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "lucide-vue-next": "^1.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vue-tsc": "^3.3.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
