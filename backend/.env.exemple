# Exemple de variables techniques du backend.
APP_NAME=EducSyn Backend
APP_ENV=development
SYNC_MODE=SYNC
PORT=3000
APP_VERSION=0.1.0

# Observabilite. En production, les metriques sont desactivees par defaut.
EDUCSYN_LOG_LEVEL=debug
EDUCSYN_METRICS_ENABLED=1
# Obligatoire en production lorsque EDUCSYN_METRICS_ENABLED=1.
EDUCSYN_METRICS_TOKEN=change-me-with-a-long-random-monitoring-token
# Le catalogue OpenAPI est actif par defaut hors production.
EDUCSYN_OPENAPI_ENABLED=1

DB_HOST=localhost
DB_PORT=5432
DB_USER=educsyn
DB_PASSWORD=educsyn
DB_NAME=educsyn
DATABASE_URL=postgres://educsyn:educsyn@localhost:5432/educsyn

# Active uniquement les suites d'integration qui utilisent PostgreSQL reel.
EDUCSYN_RUN_POSTGRES_INTEGRATION=0

# Authentification (utiliser un secret aleatoire d'au moins 32 caracteres en production)
EDUCSYN_JWT_SECRET=change-me-with-a-long-random-production-secret
EDUCSYN_DEVELOPMENT_JWT_SECRET=development-only-secret-change-me-educsyn
EDUCSYN_JWT_ISSUER=educsyn-api
EDUCSYN_JWT_AUDIENCE=educsyn-clients
EDUCSYN_ACCESS_TOKEN_TTL_SECONDS=900

REDIS_URL=redis://localhost:6379

# Redis partage / BullMQ Notifications
EDUCSYN_REDIS_MODE=auto
EDUCSYN_REDIS_HOST=127.0.0.1
EDUCSYN_REDIS_PORT=6379
EDUCSYN_REDIS_DB=0
EDUCSYN_REDIS_PREFIX=educsyn
EDUCSYN_REDIS_CONNECT_TIMEOUT_MS=5000
EDUCSYN_REDIS_IDLE_TIMEOUT_MS=30000

# Centre Audit L5. Le dossier doit rester prive et hors de tout repertoire HTTP public.
EDUCSYN_AUDIT_EXPORT_DIR=./stockage-local/audit-exports
EDUCSYN_AUDIT_EXPORT_TTL_HOURS=24
EDUCSYN_AUDIT_EXPORT_MAX_ROWS=100000
EDUCSYN_AUDIT_EXPORT_PDF_MAX_ROWS=1000

# Aucune retention destructive n'est activee par defaut.
# Une duree ne doit etre renseignee qu'apres validation de la politique metier/legale.
EDUCSYN_AUDIT_RETENTION_AUTO=0
# EDUCSYN_AUDIT_RETENTION_DAYS=
