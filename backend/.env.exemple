# Exemple de variables techniques du backend.
APP_NAME=EducSyn Backend
APP_ENV=development
SYNC_MODE=SYNC
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=educsyn
DB_PASSWORD=educsyn
DB_NAME=educsyn
DATABASE_URL=postgres://educsyn:educsyn@localhost:5432/educsyn

# Active uniquement les suites d'integration qui utilisent PostgreSQL reel.
EDUCSYN_RUN_POSTGRES_INTEGRATION=0

# Authentification (utiliser un secret aleatoire d'au moins 32 caracteres en production)
EDUCSYN_JWT_SECRET=change-me-with-a-long-random-production-secret
EDUCSYN_DEVELOPMENT_JWT_SECRET=development-only-secret-change-me-educsyn
EDUCSYN_JWT_ISSUER=educsyn-api
EDUCSYN_JWT_AUDIENCE=educsyn-clients
EDUCSYN_ACCESS_TOKEN_TTL_SECONDS=900

REDIS_URL=redis://localhost:6379

# Redis partage / BullMQ Notifications
EDUCSYN_REDIS_MODE=auto
EDUCSYN_REDIS_HOST=127.0.0.1
EDUCSYN_REDIS_PORT=6379
EDUCSYN_REDIS_DB=0
EDUCSYN_REDIS_PREFIX=educsyn
EDUCSYN_REDIS_CONNECT_TIMEOUT_MS=5000
EDUCSYN_REDIS_IDLE_TIMEOUT_MS=30000
