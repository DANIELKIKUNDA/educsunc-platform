# Exemple de variables techniques du backend.
APP_NAME=EducSyn Backend
APP_ENV=development
SYNC_MODE=SYNC
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=educsyn
DB_PASSWORD=educsyn
DB_NAME=educsyn
DATABASE_URL=postgres://educsyn:educsyn@localhost:5432/educsyn

REDIS_URL=redis://localhost:6379

# Redis partage / BullMQ Notifications
EDUCSYN_REDIS_MODE=auto
EDUCSYN_REDIS_HOST=127.0.0.1
EDUCSYN_REDIS_PORT=6379
EDUCSYN_REDIS_DB=0
EDUCSYN_REDIS_PREFIX=educsyn
EDUCSYN_REDIS_CONNECT_TIMEOUT_MS=5000
EDUCSYN_REDIS_IDLE_TIMEOUT_MS=30000
