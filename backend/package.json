{
  "name": "educsyn-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Socle backend Clean Architecture et DDD pour EducSyn.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "db:migrate:referentiel": "tsx src/scripts/MigrerReferentielAcademique.ts",
    "seed:sections-scolaires": "tsx ../scripts/seed/seed-sections-scolaires.ts",
    "seed:options-etudes": "tsx ../scripts/seed/seed-options-etudes.ts",
    "seed:classes-academiques": "tsx ../scripts/seed/seed-classes-academiques.ts",
    "seed:cours-officiels": "tsx ../scripts/seed/seed-cours-officiels.ts",
    "seed:programmes-academiques": "tsx ../scripts/seed/seed-programmes-academiques.ts",
    "seed:referentiel-academique": "npm run verifier:donnees-reference && tsx ../scripts/seed/seed-referentiel-academique.ts",
    "verifier:programme-classe": "tsx ../scripts/verification/afficher-programme-classe.ts",
    "verifier:donnees-reference": "tsx ../scripts/verification/valider-donnees-reference-referentiel-academique.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "notifications:redis:ping": "tsx src/scripts/notifications/VerifierRedisNotifications.ts",
    "test": "tsx --test src/contexts/referentiel-academique/tests/depot-annee-scolaire-postgres.test.ts src/contexts/referentiel-academique/tests/execution-http-referentiel-academique.test.ts src/contexts/referentiel-academique/tests/migrations-postgres-referentiel-academique.test.ts src/contexts/referentiel-academique/tests/orchestration-annee-scolaire.test.ts src/contexts/referentiel-academique/tests/publier-version-referentiel.test.ts",
    "test:audit": "node scripts/run-shared-audit-tests.cjs",
    "test:global": "node scripts/run-shared-global-tests.cjs",
    "test:workflows": "node scripts/run-workflow-scenario-tests.cjs",
    "test:verification": "tsx src/contexts/referentiel-academique/tests/VerificationBcReferentielAcademique.ts",
    "test:ci": "npm run verifier:donnees-reference && npm run test && npm run test:verification"
  },
  "dependencies": {
    "bullmq": "^5.77.6",
    "fastify": "^5.8.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2"
  }
}
